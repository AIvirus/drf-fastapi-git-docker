# Copy this file to .env (next to manage.py). Never upload .env to GitHub.

# Optional on your own computer (a dev-only fallback is used if empty).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Optional. Leave it commented out to use SQLite (db.sqlite3).
# Uncomment and paste your Neon connection string from Day 2 to use PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
