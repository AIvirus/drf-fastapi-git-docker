# Copy this file to .env. Never upload .env to GitHub.

# Used by `uvicorn main:app --reload` when you export it, and by Docker (Lesson 18).
APP_NAME=Study Tasks API

# Lesson 19: Docker Compose reads this file automatically and puts the value
# into compose.yaml wherever it sees ${POSTGRES_PASSWORD}.
POSTGRES_PASSWORD=pick-your-own-local-password
